# ------------------------------
# 🔐 ZOHO API CONFIGURATION
# ------------------------------
ZOHO_TOKEN_BASE_URL=<ZOHO_ACCOUNT_BASE_URL>          # e.g., https://accounts.zoho.in
ZOHO_CLIENT_ID=<ZOHO_CLIENT_ID>                      # Zoho OAuth client ID
ZOHO_CLIENT_SECRET=<ZOHO_CLIENT_SECRET>              # Zoho OAuth client secret
ZOHO_REFRESH_TOKEN=<ZOHO_REFRESH_TOKEN>              # Zoho OAuth refresh token
ZOHO_API_BASE_URL=<ZOHO_API_BASE_URL>                # e.g., https://www.zohoapis.in

# ------------------------------
# 🌐 NGROK CONFIGURATION
# ------------------------------
NGROK_AUTHTOKEN=<NGROK_AUTH_TOKEN>                   # Ngrok authentication token
NGROK_DOMAIN=<NGROK_CUSTOM_DOMAIN>                   # Optional custom domain. You can leave it empty

# ------------------------------
# 💬 NOTIFICATION SETTINGS
# ------------------------------
NOTIFICATION_MESSAGING_PROVIDER=<MESSAGING_PROVIDER>  # e.g., twilio or demo
NOTIFICATION_SYSTEM_PHONE=<SYSTEM_PHONE_NUMBER>       # e.g., 919999999999

# Allowed values: rule-based / ai-based
NOTIFICATION_PATIENT_PRIORITY_ENGINE=ai-based

# ------------------------------
# ⏱️ SCHEDULING RULES
# ------------------------------
NOTIFICATION_SCHEDULING_RESPONSE_WINDOW_MINUTES=1
NOTIFICATION_SCHEDULING_MAX_CONSECUTIVE_MISSES=3
NOTIFICATION_SCHEDULING_OPT_OUT_DURATION=PT15M       # e.g., 15 minutes

# ------------------------------
# ⚙️ APPLICATION BASE URL
# ------------------------------
APPLICATION_BASE_URL=<APPLICATION_BASE_URL>           # e.g., http://localhost:8080
